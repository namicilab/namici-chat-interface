# Supabase ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server only, never exposed

# Shared secret n8n must send as x-api-key on /api/inbound and /api/bot-message
NAMICI_API_KEY=change-me

# Where namici-ci posts operator replies so n8n can deliver them
N8N_OUTBOUND_WEBHOOK_URL=https://your-n8n/webhook/namici-outbound
